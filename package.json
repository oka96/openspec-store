{
  "name": "openspec-store",
  "version": "1.0.0",
  "private": true,
  "description": "Requirements with multiple role-owned feature specs for OpenSpec Kanban",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "spec:validate": "openspec validate --all --strict --store openspec-store",
    "store:doctor": "openspec store doctor openspec-store",
    "test": "node --test tests/*.test.mjs && node scripts/validate-samples.mjs",
    "test:seeded": "node scripts/validate-samples.mjs --seeded",
    "schema:validate": "openspec schema validate role-specs",
    "migrate:role-specs": "node scripts/migrate-role-specs.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.0"
  }
}
